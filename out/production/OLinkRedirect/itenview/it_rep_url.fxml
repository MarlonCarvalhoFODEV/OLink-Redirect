<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" maxHeight="40.0" maxWidth="1.7976931348623157E308" minHeight="40.0" minWidth="305.0" prefHeight="40.0" prefWidth="305.0" spacing="10.0" xmlns="http://javafx.com/javafx/15.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TextField fx:id="etUrlReplace" maxHeight="30.0" maxWidth="120.0" minHeight="30.0" minWidth="120.0" prefHeight="30.0" prefWidth="120.0" promptText="Substituir URL" style="-fx-background-radius: 15; -fx-border-radius: 15;">
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
      <TextField fx:id="etUrlNew" layoutX="10.0" layoutY="10.0" maxHeight="30.0" maxWidth="120.0" minHeight="30.0" minWidth="120.0" prefHeight="30.0" prefWidth="120.0" promptText="Nova URL" style="-fx-background-radius: 15; -fx-border-radius: 15;">
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
         <font>
            <Font size="14.0" />
         </font>
         <HBox.margin>
            <Insets />
         </HBox.margin>
      </TextField>
      <Button fx:id="btnRemove" mnemonicParsing="false" style="-fx-background-color: red; -fx-background-radius: 50;" text="X" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
         <HBox.margin>
            <Insets bottom="10.0" top="10.0" />
         </HBox.margin>
      </Button>
   </children>
   <padding>
      <Insets left="10.0" right="10.0" />
   </padding>
</HBox>
