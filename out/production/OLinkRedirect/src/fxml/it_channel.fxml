<AnchorPane prefHeight="50.0" style="-fx-background-color: white; -fx-background-radius: 50; -fx-border-color: gainsboro; -fx-border-radius: 50;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
