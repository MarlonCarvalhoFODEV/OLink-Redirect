            </VBox>
            <JFXButton fx:id="config_it_channel" maxHeight="25.0" maxWidth="25.0" minHeight="25.0" minWidth="25.0" prefHeight="25.0" prefWidth="25.0" ripplerFill="#05050500" style="-fx-background-color: transparent; -fx-background-radius: 25; -fx-border-radius: 25;" text=" ">
               <HBox.margin>
