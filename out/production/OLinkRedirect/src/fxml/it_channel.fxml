         <children>
            <ImageView fx:id="icon_it_channel" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../resources/comunication_gray.png" />
               </image>
               <HBox.margin>
                  <Insets left="8.0" />
               </HBox.margin>
            </ImageView>
            <VBox alignment="CENTER_LEFT" prefHeight="48.0" prefWidth="81.0">
               <HBox.margin>
                  <Insets left="8.0" />
               </HBox.margin>
               <children>
                  <Label fx:id="name_it_channel" text="Channel" textFill="#070707" />
                  <Label fx:id="specifc_it_channel" text="Label" textFill="#868686">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Label>
